{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "clementvane29",
  "dev": {
    "subreddit": "NoMoreSmokeCults"
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "media": {
    "dir": "public"
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create a new post",
        "description": "clementvane29",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Auto-Configure Subreddit (Rules, Flairs, AutoMod)",
        "description": "Programmatically apply all 6 rules, 10 flairs, and AutoMod",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/auto-configure"
      },
      {
        "label": "Seed Missing Posts (Manifesto & Whistleblower)",
        "description": "Publish the 5 baseline manifesto and evidence posts",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/seed-community"
      },
      {
        "label": "Run Complete Setup & Seed",
        "description": "One-click: rules, flairs, automod, and 5 foundational posts",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/complete-setup-and-seed"
      }
    ]
  },
  "permissions": {
    "reddit": {
      "enable": true,
      "asUser": ["SUBMIT_POST", "SUBMIT_COMMENT", "SUBSCRIBE_TO_SUBREDDIT"]
    }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
