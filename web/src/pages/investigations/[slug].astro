---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllArticles, type Article } from "../../lib/content";

export async function getStaticPaths() {
  const articles = getAllArticles();
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
---

<BaseLayout title={article.title} description={article.excerpt}>
  <div class="article-wrapper">
    <!-- Top Breadcrumb & Metadata (Bellingcat Style) -->
    <div class="article-breadcrumb">
      <a href="/">Home</a> <span>/</span> 
      <a href="/#benchmark">{article.category}</a> <span>/</span> 
      <span class="active-crumb">{article.slug}</span>
    </div>

    <div class="article-layout">
      <!-- Left Sidebar (Author Bio & Evidence Credentials) -->
      <aside class="article-aside">
        <div class="sidebar-block author-card">
          <div class="author-photo">CV</div>
          <h4 class="author-name">{article.author}</h4>
          <span class="author-role">{article.authorRole}</span>
          <p class="author-bio">
            Independent environmental philosopher and investigative essayist. Focused on green saviorism, epistemic traps in regenerative movements, and the accountability gap in global ecological finance.
          </p>
          <div class="author-links">
            <a href="https://clementvane.substack.com" target="_blank">Substack ↗</a>
            <a href="https://x.com/clementvane" target="_blank">@clementvane ↗</a>
          </div>
        </div>

        <div class="sidebar-block meta-card">
          <h5>Investigation Profile</h5>
          <div class="meta-row">
            <span class="meta-label">Category:</span>
            <span class="meta-value">{article.category}</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">Target / Subject:</span>
            <span class="meta-value">{article.target}</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">Jurisdiction:</span>
            <span class="meta-value">{article.jurisdiction}</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">Published:</span>
            <span class="meta-value">{article.date}</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">Reading Time:</span>
            <span class="meta-value">{article.readingTime}</span>
          </div>
        </div>

        <div class="sidebar-block share-card">
          <h5>Syndication Notice</h5>
          <p>
            Also published and syndicated to <a href="https://clementvane.substack.com" target="_blank">Substack</a> and verified in the public repository archive.
          </p>
          <a href="https://clementvane.substack.com" target="_blank" class="btn-substack-subscribe">
            Subscribe on Substack
          </a>
        </div>
      </aside>

      <!-- Main Article Body -->
      <article class="article-main">
        <header class="article-header">
          <div class="header-kicker">
            <span class="category-badge">{article.category}</span>
            <span class="header-date">{article.date}</span>
          </div>

          <h1 class="article-title">{article.title}</h1>

          <div class="header-meta-bar">
            <span>By <strong>{article.author}</strong></span>
            <span class="dot">•</span>
            <span>{article.readingTime}</span>
            <span class="dot">•</span>
            <span class="mono-hash">OPEN EVIDENCE DOSSIER</span>
          </div>
        </header>

        <!-- Newsletter Banner (Bellingcat Callout Style) -->
        <div class="newsletter-callout">
          <p>
            <em>Sign up <a href="https://clementvane.substack.com" target="_blank">here</a> to receive Clement Vane’s investigations and forensic dossiers by email as soon as they are published.</em>
          </p>
        </div>

        <!-- Rendered Markdown Body -->
        <div class="article-prose" set:html={article.contentHtml} />

        <!-- End of Article Footer -->
        <footer class="article-footer">
          <div class="footer-alert">
            <h4>NoMoreSmokeCults Verification Standards</h4>
            <p>
              This investigation relies solely on public records, corporate filings, open-source social footprint archives, and registered ISBN publications. If you have corrections, official filings, or documented rebuttals, contact the desk via encrypted channels.
            </p>
          </div>

          <div class="return-nav">
            <a href="/" class="btn-back">← Back to All Investigations</a>
            <a href="https://github.com/clementvane29/nomoresmokecults" target="_blank" class="btn-github">
              View Source on GitHub ↗
            </a>
          </div>
        </footer>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .article-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 30px 30px 60px;
  }

  .article-breadcrumb {
    font-size: 0.78rem;
    color: #777777;
    margin-bottom: 30px;
    font-family: var(--font-mono);
  }

  .article-breadcrumb a {
    color: #999999;
    text-decoration: none;
  }

  .article-breadcrumb a:hover {
    color: #ffffff;
  }

  .active-crumb {
    color: #dddddd;
  }

  .article-layout {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 60px;
  }

  @media (max-width: 980px) {
    .article-layout {
      grid-template-columns: 1fr;
    }
  }

  /* Aside Styles */
  .article-aside {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .sidebar-block {
    background: #0d0d0d;
    border: 1px solid #1c1c1c;
    padding: 24px;
    border-radius: 2px;
  }

  .author-photo {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #222222;
    border: 2px solid #444444;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    font-weight: 800;
    font-family: var(--font-mono);
    margin-bottom: 14px;
  }

  .author-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: #ffffff;
  }

  .author-role {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-red);
    font-weight: 600;
    margin-bottom: 12px;
  }

  .author-bio {
    font-size: 0.82rem;
    line-height: 1.6;
    color: #888888;
    margin-bottom: 16px;
  }

  .author-links {
    display: flex;
    gap: 12px;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .author-links a {
    color: #cccccc;
    text-decoration: none;
  }

  .author-links a:hover {
    color: #ffffff;
  }

  .meta-card h5,
  .share-card h5 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #888888;
    border-bottom: 1px solid #222222;
    padding-bottom: 8px;
    margin-bottom: 12px;
  }

  .meta-row {
    display: flex;
    flex-direction: column;
    margin-bottom: 10px;
    font-size: 0.8rem;
  }

  .meta-label {
    color: #666666;
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .meta-value {
    color: #dddddd;
    font-weight: 500;
  }

  .share-card p {
    font-size: 0.82rem;
    color: #888888;
    line-height: 1.5;
    margin-bottom: 14px;
  }

  .share-card a {
    color: #ffffff;
  }

  .btn-substack-subscribe {
    display: block;
    text-align: center;
    background: #ff5500;
    color: #ffffff !important;
    padding: 8px;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
  }

  /* Main Article Styles */
  .article-header {
    border-bottom: 2px solid #222222;
    padding-bottom: 24px;
    margin-bottom: 28px;
  }

  .header-kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #888888;
    margin-bottom: 16px;
  }

  .category-badge {
    background: var(--accent-red);
    color: #ffffff;
    padding: 3px 8px;
    border-radius: 2px;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: 2.8rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin-bottom: 20px;
  }

  @media (max-width: 680px) {
    .article-title {
      font-size: 2rem;
    }
  }

  .header-meta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    font-size: 0.85rem;
    color: #888888;
  }

  .mono-hash {
    font-family: var(--font-mono);
    color: #555555;
    font-size: 0.75rem;
  }

  /* Newsletter Box (Bellingcat Cream/Yellow Accent) */
  .newsletter-callout {
    background-color: var(--accent-yellow);
    color: #1a1a1a;
    padding: 16px 22px;
    margin-bottom: 36px;
    border-left: 4px solid #ff4500;
    font-size: 0.95rem;
  }

  .newsletter-callout a {
    color: #000000;
    font-weight: 700;
    text-decoration: underline;
  }

  /* Article Prose Formatting */
  .article-prose {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.75;
    color: #d8d8d8;
  }

  .article-prose :global(h1) {
    display: none; /* Already rendered in header */
  }

  .article-prose :global(h2) {
    font-family: var(--font-sans);
    font-size: 1.7rem;
    font-weight: 700;
    color: #ffffff;
    margin-top: 48px;
    margin-bottom: 18px;
    border-bottom: 1px solid #222222;
    padding-bottom: 8px;
    letter-spacing: -0.01em;
  }

  .article-prose :global(h3) {
    font-family: var(--font-sans);
    font-size: 1.35rem;
    font-weight: 600;
    color: #f0f0f0;
    margin-top: 36px;
    margin-bottom: 14px;
  }

  .article-prose :global(p) {
    margin-bottom: 24px;
  }

  .article-prose :global(ul),
  .article-prose :global(ol) {
    margin-bottom: 24px;
    padding-left: 28px;
  }

  .article-prose :global(li) {
    margin-bottom: 8px;
  }

  .article-prose :global(blockquote) {
    background: #0d0d0d;
    border-left: 4px solid var(--accent-red);
    padding: 18px 24px;
    margin: 30px 0;
    font-style: italic;
    color: #bbbbbb;
  }

  .article-prose :global(hr) {
    border: none;
    border-top: 1px solid #222222;
    margin: 40px 0;
  }

  .article-prose :global(a) {
    color: #ffffff;
    text-decoration: underline;
    text-decoration-color: var(--accent-red);
    text-underline-offset: 4px;
    transition: color 0.15s;
  }

  .article-prose :global(a:hover) {
    color: var(--accent-red);
  }

  .article-prose :global(strong) {
    color: #ffffff;
    font-weight: 700;
  }

  .article-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 30px 0;
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }

  .article-prose :global(th),
  .article-prose :global(td) {
    border: 1px solid #222222;
    padding: 12px 14px;
    text-align: left;
  }

  .article-prose :global(th) {
    background: #141414;
    color: #ffffff;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.05em;
  }

  .article-prose :global(code) {
    font-family: var(--font-mono);
    background: #141414;
    padding: 2px 6px;
    border-radius: 2px;
    font-size: 0.9em;
    color: #ffaa55;
  }

  /* Article Footer */
  .article-footer {
    margin-top: 60px;
    border-top: 2px solid #222222;
    padding-top: 40px;
  }

  .footer-alert {
    background: #0f0f0f;
    border: 1px solid #222222;
    border-left: 4px solid var(--accent-red);
    padding: 24px;
    margin-bottom: 30px;
  }

  .footer-alert h4 {
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .footer-alert p {
    font-size: 0.85rem;
    color: #888888;
    line-height: 1.6;
  }

  .return-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .btn-back,
  .btn-github {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 0.05em;
    padding: 10px 18px;
    border-radius: 2px;
  }

  .btn-back {
    background: #ffffff;
    color: #000000;
  }

  .btn-github {
    border: 1px solid #444444;
    color: #ffffff;
  }
</style>
